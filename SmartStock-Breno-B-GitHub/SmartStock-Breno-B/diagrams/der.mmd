erDiagram
    CATEGORIAS ||--o{ PRODUTOS : possui
    PRODUTOS ||--o{ MOVIMENTACOES : registra
    USUARIOS ||--o{ MOVIMENTACOES : realiza

    CATEGORIAS {
        int id PK
        varchar nome
    }
    PRODUTOS {
        int id PK
        varchar nome
        int categoria_id FK
        int quantidade
        int estoque_minimo
        decimal preco
        datetime data_cadastro
    }
    USUARIOS {
        int id PK
        varchar nome
        varchar email
        varchar senha
        datetime data_cadastro
    }
    MOVIMENTACOES {
        int id PK
        int produto_id FK
        int usuario_id FK
        varchar tipo
        int quantidade
        datetime data
    }
